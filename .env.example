# Copy to .env and fill in, then run scripts/up.sh

# AppSignal app name the Ruby services report as.
APPSIGNAL_APP_NAME="Ijzerhaven Orders"
# Push API key (organization or app-specific).
APPSIGNAL_PUSH_API_KEY=
# "Collector URL" from App settings -> Hosted Collector. Needed for distributed
# traces across orders-web and payments-api.
APPSIGNAL_COLLECTOR_ENDPOINT=
# App-specific push API key for the Kubernetes agent (Cluster Metrics). Leave
# empty on the first run if the app doesn't exist yet; rerun up.sh once it does.
APPSIGNAL_K8S_API_KEY=

# Front-end API key ("Front-end error monitoring" in App settings). Public:
# it ships in the storefront bundle. Used by scripts/up.sh at build time.
APPSIGNAL_FRONTEND_API_KEY=
